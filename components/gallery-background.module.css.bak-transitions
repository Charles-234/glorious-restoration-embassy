.background {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background: hsl(var(--background));
}

.layer {
  position: absolute;
  inset: 0;
  overflow: hidden;
  opacity: 1;
  animation: bgFade 4s ease-in-out infinite;
}

@keyframes bgFade {
  0%, 45% { opacity: 1; }
  55%, 100% { opacity: 0.85; }
}

.image {
  object-fit: contain;
  opacity: 0.3;
}
