/* ==========================================================================
   Dual-Theme Glassmorphism Framework (styles.css)
   Accessible styling rules engine for light and dark modes.
   ========================================================================== */

:root {
  /* 1. DUAL-THEME GLASS VARIABLES */
  /* Light Mode Colors */
  --bg-glass-light: rgba(255, 255, 255, 0.45);
  --border-glass-light: rgba(255, 255, 255, 0.65);
  --text-glass-light: #1E293B;

  /* Night Mode Colors */
  --bg-glass-dark: rgba(15, 23, 42, 0.65);
  --border-glass-dark: rgba(255, 255, 255, 0.15);
  --text-glass-dark: #FFFFFF;
}

/* 2. CORE GLASS UTILITY CLASSES & 3. TEXT VISIBILITY GUARDRAILS */

/* Light Mode Glass Card */
.glass-card-light {
  background: var(--bg-glass-light);
  border: 1px solid var(--border-glass-light);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  backdrop-filter: blur(14px) saturate(140%);
  transform: translate3d(0, 0, 0);
}

.glass-card-light,
.glass-card-light * {
  color: var(--text-glass-light);
  font-weight: 600;
}

.glass-card-light h1,
.glass-card-light h2,
.glass-card-light h3,
.glass-card-light h4,
.glass-card-light h5,
.glass-card-light h6 {
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
}

/* Night Mode Glass Card */
.glass-card-dark {
  background: var(--bg-glass-dark);
  border: 1px solid var(--border-glass-dark);
  -webkit-backdrop-filter: blur(16px) saturate(150%);
  backdrop-filter: blur(16px) saturate(150%);
  transform: translate3d(0, 0, 0);
}

.glass-card-dark,
.glass-card-dark * {
  color: var(--text-glass-dark);
  font-weight: 500;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
}

@media (prefers-reduced-transparency: reduce) {
  .glass-card-light {
    background: rgba(255, 255, 255, 0.94);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .glass-card-dark {
    background: rgba(15, 23, 42, 0.96);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}

@media (forced-colors: active) {
  .glass-card-light,
  .glass-card-dark {
    background: Canvas;
    border-color: CanvasText;
    color: CanvasText;
    forced-color-adjust: auto;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .glass-card-light *,
  .glass-card-dark * {
    color: CanvasText !important;
    text-shadow: none;
  }
}


/* Dark mode override — keep white text on dark background */


@media (max-width: 640px) {
  .gre-footer-legal {
    justify-content: flex-start;
    gap: 0.75rem;
  }
  
}

/* Legal footer links — high contrast in BOTH modes */
.gre-footer-legal {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: flex-end;
  align-items: center;
}
.gre-footer-legal-link {
  font-size: 0.95rem !important;
  font-weight: 800 !important;
  color: #000000 !important;
  background: #ffffff !important;
  border: 2px solid #000000 !important;
  padding: 0.5rem 1.1rem !important;
  border-radius: 9999px !important;
  text-decoration: none !important;
  transition: all 0.2s ease !important;
  line-height: 1.2 !important;
}
.gre-footer-legal-link:hover {
  background: #c59d5f !important;
  color: #000000 !important;
  transform: translateY(-1px);
}
.dark .gre-footer-legal-link {
  color: #ffffff !important;
  background: rgba(255, 255, 255, 0.15) !important;
  border: 2px solid rgba(255, 255, 255, 0.6) !important;
}
.dark .gre-footer-legal-link:hover {
  background: #c59d5f !important;
  color: #000000 !important;
  border-color: #c59d5f !important;
}
.gre-footer-legal-admin {
  font-size: 0.85rem !important;
  opacity: 0.85 !important;
}

/* Also boost the "Legal & Resources" column heading & links */
.gre-footer a {
  color: inherit;
}
.gre-footer h2 {
  color: inherit;
  font-weight: 700;
}
